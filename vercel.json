{
  "name": "ragbot",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "runtime": "python3.11",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/proxy.py?path=$1" },
    { "src": "/(.*)", "dest": "/static/$1" }
  ],
  "overrides": {
    "static/index.html": { "contentType": "text/html" }
  }
}
