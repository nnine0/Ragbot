# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INGESTION_TOPIC=document-ingestion
KAFKA_DLQ_TOPIC=document-ingestion-dlq
KAFKA_CONSUMER_GROUP=rag-worker-group

# ChromaDB
CHROMA_HOST=chroma-server
CHROMA_PORT=8000
CHROMA_COLLECTION=user_docs

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ragreader-files
MINIO_USE_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# HuggingFace
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_GENERATION_MODEL=google/flan-t5-large
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# Server
API_HOST=0.0.0.0
API_PORT=8080
WORKER_CONCURRENCY=4
